# embed.cmake — cmake -DROOT=<dir> -DFILES=<a|b|…> -DOUT=<header> -P embed.cmake writes the files
# (paths relative to ROOT) as byte arrays, with a table of them by path, for the app to serve its
# page from (after Forte's cmake/embed.cmake, which embeds one).
string(REPLACE "|" ";" files "${FILES}")
set(body "// generated by cmake/embed.cmake. Do not edit.\n#pragma once\n#include <cstddef>\n#include <string_view>\n\nnamespace phuzzbox::embedded {\n\n")
set(table "")
set(k 0)
foreach(f ${files})
  file(READ ${ROOT}/${f} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  string(APPEND body "inline const unsigned char file${k}[] = {\n${bytes}0x00};\n")
  string(APPEND table "  {\"/${f}\", std::string_view((const char *)file${k}, ${size})},\n")
  math(EXPR k "${k} + 1")
endforeach()
string(APPEND body "\nstruct File { std::string_view path, data; };\ninline const File files[] = {\n${table}};\n\n} // namespace phuzzbox::embedded\n")
file(WRITE ${OUT} "${body}")
